<?xml version="1.0" encoding="utf-8"?>
<!-- Never restore preferences across devices/installs: SAF grants and the
     encrypted-passphrase master key are device-bound, so a restored copy would
     be unusable (and EncryptedSharedPreferences can crash on a stale key). -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="private_outputs/" />
    <exclude domain="database" path="job_journal.db" />
</full-backup-content>
