<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:text="Batch processing" android:textAppearance="?attr/textAppearanceTitleLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:text="Add files, choose an action, then start. Progress remains visible while work runs." android:textAppearance="?attr/textAppearanceBodySmall" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <com.google.android.material.chip.ChipGroup android:id="@+id/modeGroup" app:singleSelection="true" android:layout_width="wrap_content" android:layout_height="wrap_content"><com.google.android.material.chip.Chip android:id="@+id/modeEncrypt" android:text="Encrypt" android:checkable="true" android:checked="true" android:layout_width="wrap_content" android:layout_height="wrap_content" /><com.google.android.material.chip.Chip android:id="@+id/modeDecrypt" android:text="Decrypt" android:checkable="true" android:layout_width="wrap_content" android:layout_height="wrap_content" /><com.google.android.material.chip.Chip android:id="@+id/modeVerify" android:text="Verify" android:checkable="true" android:layout_width="wrap_content" android:layout_height="wrap_content" /></com.google.android.material.chip.ChipGroup>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content"><com.google.android.material.button.MaterialButton android:id="@+id/pickBtn" android:text="Add images…" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" /><com.google.android.material.button.MaterialButton android:id="@+id/pickFolderBtn" style="?attr/materialButtonOutlinedStyle" android:text="Add folder…" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" /></LinearLayout>
    <TextView android:id="@+id/queueView" android:text="Queue is empty." android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <com.google.android.material.button.MaterialButton android:id="@+id/clearQueueBtn" style="@style/Widget.Material3.Button.TextButton" android:text="Clear queue" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <com.google.android.material.textfield.TextInputLayout android:hint="Passphrase" android:layout_width="match_parent" android:layout_height="wrap_content"><com.google.android.material.textfield.TextInputEditText android:id="@+id/pass" android:inputType="textPassword" android:layout_width="match_parent" android:layout_height="wrap_content" /></com.google.android.material.textfield.TextInputLayout>
    <TextView android:id="@+id/iterLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" /><com.google.android.material.slider.Slider android:id="@+id/iter" android:value="200000" android:valueFrom="10000" android:valueTo="2000000" android:stepSize="10000" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/manualOutView" android:layout_width="wrap_content" android:layout_height="wrap_content" /><com.google.android.material.button.MaterialButton android:id="@+id/outputBtn" style="?attr/materialButtonOutlinedStyle" android:text="Choose batch output folder…" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/batchStatus" android:text="Ready" android:textAppearance="?attr/textAppearanceBodyMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/batchProgress" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/batchDetail" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <com.google.android.material.button.MaterialButton android:id="@+id/startBtn" android:text="Encrypt queued files" android:enabled="false" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <com.google.android.material.button.MaterialButton android:id="@+id/batchCheckBtn" style="?attr/materialButtonOutlinedStyle" android:text="Run setup &amp; encryption test" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/batchCheckStatus" android:text="Run the test before your first batch." android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <ImageView android:id="@+id/preview" android:visibility="gone" android:scaleType="fitCenter" android:layout_width="match_parent" android:layout_height="180dp" />
    <LinearLayout android:id="@+id/results" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
