<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <TextView android:text="3 · Auto-decrypt a folder" android:textAppearance="?attr/textAppearanceTitleMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:text="Automatically decrypt existing files on request and future OptiCipher PNG files." android:textAppearance="?attr/textAppearanceBodySmall" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <com.google.android.material.textfield.TextInputLayout android:hint="Auto-decrypt passphrase" android:layout_width="match_parent" android:layout_height="wrap_content"><com.google.android.material.textfield.TextInputEditText android:id="@+id/decryptWatchPass" android:inputType="textPassword" android:layout_width="match_parent" android:layout_height="wrap_content" /></com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/decryptWatchRemember" android:text="Remember passphrase securely for background use" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/decryptWatchFolders" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <com.google.android.material.button.MaterialButton android:id="@+id/decryptWatchFolderBtn" style="?attr/materialButtonOutlinedStyle" android:text="Grant access to folder to decrypt…" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <com.google.android.material.button.MaterialButton android:id="@+id/decryptWatchOutputBtn" style="?attr/materialButtonOutlinedStyle" android:text="Choose decrypted-output folder…" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/decryptExisting" android:text="Decrypt existing images when turning on" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <com.google.android.material.chip.ChipGroup android:id="@+id/decryptConflictGroup" app:singleSelection="true" android:layout_width="wrap_content" android:layout_height="wrap_content"><com.google.android.material.chip.Chip android:id="@+id/decryptSkip" android:text="If output exists: Skip" android:checkable="true" android:checked="true" android:layout_width="wrap_content" android:layout_height="wrap_content" /><com.google.android.material.chip.Chip android:id="@+id/decryptOverwrite" android:text="Overwrite" android:checkable="true" android:layout_width="wrap_content" android:layout_height="wrap_content" /></com.google.android.material.chip.ChipGroup>
    <com.google.android.material.chip.ChipGroup android:id="@+id/decryptIntervalGroup" app:singleSelection="true" android:layout_width="wrap_content" android:layout_height="wrap_content"><com.google.android.material.chip.Chip android:id="@+id/decryptImmediate" android:text="Watch immediately" android:checkable="true" android:layout_width="wrap_content" android:layout_height="wrap_content" /><com.google.android.material.chip.Chip android:id="@+id/decrypt15" android:text="Check 15 min" android:checkable="true" android:checked="true" android:layout_width="wrap_content" android:layout_height="wrap_content" /><com.google.android.material.chip.Chip android:id="@+id/decrypt60" android:text="1 hour" android:checkable="true" android:layout_width="wrap_content" android:layout_height="wrap_content" /></com.google.android.material.chip.ChipGroup>
    <TextView android:id="@+id/decryptWatchStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><com.google.android.material.button.MaterialButton android:id="@+id/decryptWatchStart" android:text="Turn on auto-decrypt" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" /><com.google.android.material.button.MaterialButton android:id="@+id/decryptWatchStop" style="?attr/materialButtonOutlinedStyle" android:text="Turn off" android:layout_width="wrap_content" android:layout_height="wrap_content" /></LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/decryptCheckBtn" style="?attr/materialButtonOutlinedStyle" android:text="Check setup &amp; run test" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/decryptCheckStatus" android:text="Checks permissions, folders, passphrase, and crypto." android:layout_width="wrap_content" android:layout_height="wrap_content" />
</LinearLayout>
