<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <TextView android:text="2 · Auto-encrypt a folder" android:textAppearance="?attr/textAppearanceTitleMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:text="Automatically encrypt existing and new PNG, JPEG, WebP, or BMP images. Encrypted output is lossless PNG." android:textAppearance="?attr/textAppearanceBodySmall" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <com.google.android.material.textfield.TextInputLayout android:hint="Auto-encrypt passphrase" android:layout_width="match_parent" android:layout_height="wrap_content"><com.google.android.material.textfield.TextInputEditText android:id="@+id/encryptWatchPass" android:inputType="textPassword" android:layout_width="match_parent" android:layout_height="wrap_content" /></com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/encryptWatchRemember" android:text="Remember passphrase securely for background use" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/encryptWatchFolders" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <com.google.android.material.button.MaterialButton android:id="@+id/encryptWatchFolderBtn" style="?attr/materialButtonOutlinedStyle" android:text="Grant access to folder to encrypt…" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <com.google.android.material.button.MaterialButton android:id="@+id/encryptWatchOutputBtn" style="?attr/materialButtonOutlinedStyle" android:text="Choose encrypted-output folder…" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/encryptExisting" android:text="Encrypt existing images when turning on" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <com.google.android.material.chip.ChipGroup android:id="@+id/encryptConflictGroup" app:singleSelection="true" android:layout_width="wrap_content" android:layout_height="wrap_content"><com.google.android.material.chip.Chip android:id="@+id/encryptSkip" android:text="If output exists: Skip" android:checkable="true" android:checked="true" android:layout_width="wrap_content" android:layout_height="wrap_content" /><com.google.android.material.chip.Chip android:id="@+id/encryptOverwrite" android:text="Overwrite" android:checkable="true" android:layout_width="wrap_content" android:layout_height="wrap_content" /></com.google.android.material.chip.ChipGroup>
    <com.google.android.material.chip.ChipGroup android:id="@+id/encryptIntervalGroup" app:singleSelection="true" android:layout_width="wrap_content" android:layout_height="wrap_content"><com.google.android.material.chip.Chip android:id="@+id/encryptImmediate" android:text="Watch immediately" android:checkable="true" android:layout_width="wrap_content" android:layout_height="wrap_content" /><com.google.android.material.chip.Chip android:id="@+id/encrypt15" android:text="Check 15 min" android:checkable="true" android:checked="true" android:layout_width="wrap_content" android:layout_height="wrap_content" /><com.google.android.material.chip.Chip android:id="@+id/encrypt60" android:text="1 hour" android:checkable="true" android:layout_width="wrap_content" android:layout_height="wrap_content" /></com.google.android.material.chip.ChipGroup>
    <TextView android:id="@+id/encryptWatchStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><com.google.android.material.button.MaterialButton android:id="@+id/encryptWatchStart" android:text="Turn on auto-encrypt" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" /><com.google.android.material.button.MaterialButton android:id="@+id/encryptWatchStop" style="?attr/materialButtonOutlinedStyle" android:text="Turn off" android:layout_width="wrap_content" android:layout_height="wrap_content" /></LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/encryptCheckBtn" style="?attr/materialButtonOutlinedStyle" android:text="Check setup &amp; run test" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/encryptCheckStatus" android:text="Checks permissions, folders, passphrase, and crypto." android:layout_width="wrap_content" android:layout_height="wrap_content" />
</LinearLayout>
